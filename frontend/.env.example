# Online Book Store — frontend environment template
#
# Copy this file to frontend/.env.local (or .env.development.local) and
# adjust the values. All variables must be prefixed with VITE_ to reach
# the browser bundle. They are read in one place: frontend/src/config.ts.

# Base URL of the Django API. The default "/api" works with the Vite dev
# proxy (vite.config.ts) and with the nginx container, which proxies /api/
# to the backend. Set a full URL only when calling the API cross-origin.
VITE_API_BASE_URL=/api
