# Online Book Store — frontend production environment.
#
# Vite loads this file automatically for "vite build" (NODE_ENV=production),
# which is what Vercel runs. It is committed on purpose: only VITE_-prefixed
# variables reach the browser bundle, the bundle is public, and there is no
# secret here. Never add a secret to any VITE_ variable.
#
# Read in exactly one place: frontend/src/config.ts.

# Keep the API on the SAME ORIGIN as the site in production.
#
# frontend/vercel.json rewrites /api/* to the Render service server-side, so
# the browser only ever talks to the Vercel origin. That is what keeps the
# session and CSRF cookies first-party: every fetch in src/api.ts uses
# credentials: "same-origin", and Safari and Firefox block the third-party
# cookies a cross-origin API URL would require. The session cookie no longer
# authenticates anybody -- that is the Firebase ID token's job -- but it still
# keys a guest cart, which would be dropped at sign-in without it.
#
# So do NOT point this at https://bookstore-api.onrender.com — that would be
# cross-origin and log-ins would fail on those browsers. Change the rewrite
# destination in vercel.json instead.
VITE_API_BASE_URL=/api

# --- Firebase Authentication ---------------------------------------------
#
# Set these six values in the Vercel project (Settings -> Environment
# Variables). Vercel injects them into the build, and Vite gives a real
# environment variable precedence over this file, so the empty defaults
# here are overridden rather than shipped.
#
# They are left empty rather than committed only because the Firebase
# project is chosen per deployment; a web config is not a secret (see
# frontend/.env.example). The project id must match the backend's
# FIREBASE_PROJECT_ID on Render.
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=
