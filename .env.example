# Root environment file used by docker-compose.yml
# Copy to .env and fill in real values: cp .env.example .env
#
# These variables are read by backend/config/env.py (the central
# configuration module). See backend/.env.example for the full list.

DJANGO_SECRET_KEY=change-me-generate-a-real-key
DJANGO_DEBUG=false
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1

# Set to true when TLS is terminated in front of the backend (reverse
# proxy or load balancer); enables the HTTPS-only security settings.
HTTPS_ENABLED=false

# Comma-separated origins Django may trust for CSRF-protected cross-origin
# requests (empty while the React app is served behind the same origin).
CSRF_TRUSTED_ORIGINS=

DB_NAME=online_book_store
DB_USER=bookstore
DB_PASSWORD=change-me
DB_HOST=db
DB_PORT=3306

SESSION_COOKIE_AGE=900

# --- Backups (issue #18, OBS-NF-006) ---------------------------------------------
# Directory that "manage.py backup_data" writes order and inventory backups
# into. A relative path is resolved against the backend directory, so this
# means backend/backups. Use a mounted volume in production so backups
# outlive the container.
BACKUP_DIR=backups

# Days of backup artifacts to keep on disk. The BackupRun execution records
# stay in the database regardless, so the schedule remains auditable.
BACKUP_RETENTION_DAYS=14

# OBS-NF-006 requires a backup at least every 24 hours;
# "manage.py verify_backups" fails when the newest one is older than this.
BACKUP_MAX_AGE_HOURS=24
