# Root environment file used by docker-compose.yml
# Copy to .env and fill in real values: cp .env.example .env
#
# These variables are read by backend/config/env.py (the central
# configuration module). See backend/.env.example for the full list.

DJANGO_SECRET_KEY=change-me-generate-a-real-key
DJANGO_DEBUG=false
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1

# Set to true when TLS is terminated in front of the backend (reverse
# proxy or load balancer); enables the HTTPS-only security settings.
HTTPS_ENABLED=false

# Comma-separated origins Django may trust for CSRF-protected cross-origin
# requests (empty while the React app is served behind the same origin).
CSRF_TRUSTED_ORIGINS=

DB_NAME=online_book_store
DB_USER=bookstore
DB_PASSWORD=change-me
DB_HOST=db
DB_PORT=3306

# The compose "db" service is a plain local MySQL container on a private
# network, so TLS is off here. Against a managed provider (Aiven) set
# DB_SSL_REQUIRED=true, or DB_SSL_CA to the provider's CA bundle to verify
# the server certificate as well.
DB_SSL_CA=
DB_SSL_REQUIRED=false

# Seconds to reuse a database connection; 0 reconnects per request.
DB_CONN_MAX_AGE=0

SESSION_COOKIE_AGE=900

# --- Firebase Authentication ---------------------------------------------
# The Firebase project whose ID tokens the backend accepts; required for
# anyone to sign in. The frontend image needs the matching VITE_FIREBASE_*
# values at BUILD time (they are compiled into the bundle), so set them in
# frontend/.env.production or pass them as build arguments -- listing them
# here would have no effect on the built frontend.
FIREBASE_PROJECT_ID=
FIREBASE_TOKEN_LEEWAY=30

# --- Redis cache (Upstash) ------------------------------------------------
# Connection URL for the response cache. Upstash's TCP endpoint is
# TLS-only, so the URL starts with rediss:// and contains the password --
# keep it out of version control. Empty means no caching, which is the
# right default for a local compose stack.
REDIS_URL=
CACHE_ENABLED=true
REDIS_TIMEOUT=2

# --- Backups (issue #18, OBS-NF-006) ---------------------------------------------
# Directory that "manage.py backup_data" writes order and inventory backups
# into. A relative path is resolved against the backend directory, so this
# means backend/backups. Use a mounted volume in production so backups
# outlive the container.
BACKUP_DIR=backups

# Days of backup artifacts to keep on disk. The BackupRun execution records
# stay in the database regardless, so the schedule remains auditable.
BACKUP_RETENTION_DAYS=14

# OBS-NF-006 requires a backup at least every 24 hours;
# "manage.py verify_backups" fails when the newest one is older than this.
BACKUP_MAX_AGE_HOURS=24
