# Online Book Store — backend environment template
#
# Copy this file to backend/.env and fill in real values:
#
#     cp backend/.env.example backend/.env
#
# backend/.env is git-ignored and must never be committed.
# Existing process environment variables take precedence over .env values.

# --- Security -----------------------------------------------------------------
# Required. Generate one with:
#   python -c "from django.core.management.utils import get_random_secret_key; print(get_random_secret_key())"
DJANGO_SECRET_KEY=change-me

# "true" enables development/debug mode. Set to "false" in production; this
# also turns on the production security settings in config/settings.py.
DJANGO_DEBUG=true

# Comma-separated list of hosts the app may serve.
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1

# --- MySQL database -------------------------------------------------------------
# Required. Create the database before running migrations, e.g.:
#   mysql -u root -p -e "CREATE DATABASE online_book_store CHARACTER SET utf8mb4;"
DB_NAME=online_book_store
DB_USER=root
DB_PASSWORD=change-me
DB_HOST=localhost
DB_PORT=3306

# Aiven and other managed MySQL providers accept only TLS connections.
# Set DB_SSL_CA to a CA bundle path for a verified connection (preferred in
# production); DB_SSL_REQUIRED=true encrypts without verifying the server
# certificate and is enough for local work against a managed instance.
DB_SSL_CA=
DB_SSL_REQUIRED=true

# Seconds to reuse a database connection. 0 reconnects per request, which is
# the right default locally; production uses 60. Each gunicorn worker holds
# its own connection, so keep (workers x instances) under the plan's limit.
DB_CONN_MAX_AGE=0

# --- Sessions -------------------------------------------------------------------
# Inactivity timeout (seconds) after which a session expires.
SESSION_COOKIE_AGE=900

# --- Firebase Authentication ---------------------------------------------
# The Firebase project whose ID tokens this API accepts. It must be the
# same project as the frontend's VITE_FIREBASE_PROJECT_ID; the project id
# is the token's audience, which is what stops a token minted for another
# Firebase project being accepted here. Required for anyone to sign in.
#
# No service-account JSON is needed: tokens are verified against Google's
# public signing certificates. A project id is not a secret.
FIREBASE_PROJECT_ID=

# Seconds of clock skew tolerated on a token's exp/iat claims. The default
# is fine unless the container's clock drifts.
FIREBASE_TOKEN_LEEWAY=30

# --- Redis cache (Upstash) ------------------------------------------------
# Connection URL for the Redis instance that caches API responses. Use
# Upstash's **TCP** endpoint, which is TLS-only, so the URL starts with
# rediss:// and carries the password:
#
#   rediss://default:<password>@<endpoint>.upstash.io:6379
#
# This is a SECRET. Leave it empty to run without a cache: every read then
# goes to MySQL, which is the right default for local work.
REDIS_URL=

# Kill switch: false stops the API serving reads from the cache while
# leaving REDIS_URL in place. Reach for this first if cached data is ever
# suspected of being stale.
CACHE_ENABLED=true

# Seconds to wait for Redis before giving up on a cache operation and
# reading from the database instead.
REDIS_TIMEOUT=2

# --- Deployment -------------------------------------------------------------------
# Comma-separated origins Django may trust for CSRF-protected cross-origin
# requests (leave empty while the React app is served through the Vite proxy).
CSRF_TRUSTED_ORIGINS=

# Set to true when TLS is terminated in front of Django (reverse proxy or load
# balancer); enables the HTTPS-only production security settings.
HTTPS_ENABLED=false

# --- Backups (issue #18, OBS-NF-006) ---------------------------------------------
# Directory that "manage.py backup_data" writes order and inventory backups
# into. A relative path is resolved against the backend directory, so this
# means backend/backups. Use a mounted volume in production so backups
# outlive the container.
BACKUP_DIR=backups

# Days of backup artifacts to keep on disk. The BackupRun execution records
# stay in the database regardless, so the schedule remains auditable.
BACKUP_RETENTION_DAYS=14

# OBS-NF-006 requires a backup at least every 24 hours;
# "manage.py verify_backups" fails when the newest one is older than this.
BACKUP_MAX_AGE_HOURS=24
