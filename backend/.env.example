# Online Book Store — backend environment template
#
# Copy this file to backend/.env and fill in real values:
#
#     cp backend/.env.example backend/.env
#
# backend/.env is git-ignored and must never be committed.
# Existing process environment variables take precedence over .env values.

# --- Security -----------------------------------------------------------------
# Required. Generate one with:
#   python -c "from django.core.management.utils import get_random_secret_key; print(get_random_secret_key())"
DJANGO_SECRET_KEY=change-me

# "true" enables development/debug mode. Set to "false" in production; this
# also turns on the production security settings in config/settings.py.
DJANGO_DEBUG=true

# Comma-separated list of hosts the app may serve.
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1

# --- MySQL database -------------------------------------------------------------
# Required. Create the database before running migrations, e.g.:
#   mysql -u root -p -e "CREATE DATABASE online_book_store CHARACTER SET utf8mb4;"
DB_NAME=online_book_store
DB_USER=root
DB_PASSWORD=change-me
DB_HOST=localhost
DB_PORT=3306

# --- Sessions -------------------------------------------------------------------
# Inactivity timeout (seconds) after which a session expires.
SESSION_COOKIE_AGE=900

# --- Deployment -------------------------------------------------------------------
# Comma-separated origins Django may trust for CSRF-protected cross-origin
# requests (leave empty while the React app is served through the Vite proxy).
CSRF_TRUSTED_ORIGINS=

# Set to true when TLS is terminated in front of Django (reverse proxy or load
# balancer); enables the HTTPS-only production security settings.
HTTPS_ENABLED=false

