# Never copy real configuration into the image. The deployment supplies
# configuration as environment variables (see render.yaml), so any local .env
# would both leak credentials into the image layers and silently override
# them, because config/env.py loads backend/.env when it is present.
#
# Ignore every .env variant, then allow back the committed, secret-free
# templates so the image still documents its own configuration.
.env*
!.env.example
!.env.production.example

__pycache__/
*.py[cod]
.venv/

# Generated at container start by entrypoint.sh.
staticfiles/

# Backup artifacts written by "manage.py backup_data".
backups/
