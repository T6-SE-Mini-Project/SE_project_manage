# Online Book Store — backend PRODUCTION environment reference.
#
# On Render there is no .env file: the service reads real environment
# variables, which render.yaml declares and the Render dashboard stores. This
# file is the human-readable copy of what those values should be, so the
# production configuration is reviewable in git without any secret in it.
#
# Use it in one of two ways:
#   1. Deploy render.yaml as a Blueprint; Render prompts for every value
#      marked "sync: false" there. (Recommended.)
#   2. Or create the service by hand and paste these keys into
#      Render -> your service -> Environment, replacing each <...> placeholder.
#
# NEVER commit real credentials. Fill the placeholders in the dashboard only.
# Every variable below is read by backend/config/env.py.

# --- Security -------------------------------------------------------------
# Generate once and keep it stable; changing it logs every user out.
#   python -c "from django.core.management.utils import get_random_secret_key; print(get_random_secret_key())"
# render.yaml uses "generateValue: true" so Render creates this for you.
DJANGO_SECRET_KEY=<generated-by-render>

# Must be false in production. This is what enables the security block at the
# bottom of config/settings.py.
DJANGO_DEBUG=false

# Hosts this service may serve. config/env.py appends Render's own
# RENDER_EXTERNAL_HOSTNAME automatically, so this only needs custom domains.
DJANGO_ALLOWED_HOSTS=bookstore-api.onrender.com

# Render terminates TLS at its edge. "true" turns on SECURE_SSL_REDIRECT,
# Secure session/CSRF cookies, HSTS, and the X-Forwarded-Proto trust that
# stops the redirect loop.
HTTPS_ENABLED=true

# The ORIGIN THE BROWSER USES — the Vercel site, not this service. Requests
# reach Django through Vercel's /api rewrite still carrying the Vercel Origin
# header, and Django's CSRF check rejects any origin missing from this list.
# Comma-separated; add custom domains as extra entries.
CSRF_TRUSTED_ORIGINS=https://<your-project>.vercel.app

# --- Managed MySQL (Aiven, already deployed) -------------------------------
DB_NAME=<aiven-database-name>
DB_USER=<aiven-user>
DB_PASSWORD=<aiven-password>
DB_HOST=<your-service>.aivencloud.com
DB_PORT=<aiven-port>

# Aiven refuses unencrypted connections.
#
# Preferred: download Aiven's CA certificate, add it in Render under
# Environment -> Secret Files (for example as "aiven-ca.pem"), and set
# DB_SSL_CA to the path Render mounts it at. This verifies the server
# certificate, which protects against an active man-in-the-middle.
DB_SSL_CA=/etc/secrets/aiven-ca.pem

# Fallback used only when DB_SSL_CA is empty: encrypt the connection but do
# not verify the certificate. Enough to get deployed; weaker than the above.
DB_SSL_REQUIRED=true

# Reuse a connection for 60s instead of reconnecting every request. Each
# gunicorn worker keeps its own, so (workers x instances) must stay under the
# Aiven plan's connection limit.
DB_CONN_MAX_AGE=60

# --- Sessions -------------------------------------------------------------
# Inactivity timeout in seconds (15 minutes), per the project's security
# requirement.
SESSION_COOKIE_AGE=900

# --- Gunicorn -------------------------------------------------------------
# Worker count, read by backend/entrypoint.sh. Two fits Render's free 512 MB.
WEB_CONCURRENCY=2

# --- Backups (issue #18, OBS-NF-006) --------------------------------------
# WARNING: Render's container filesystem is ephemeral, and the free plan has
# no persistent disks, so artifacts written here are lost on every restart or
# deploy. For a real backup guarantee, attach a Render Disk and point
# BACKUP_DIR at its mount path, or copy the artifacts to object storage.
# The BackupRun audit rows live in MySQL and survive regardless.
BACKUP_DIR=backups
BACKUP_RETENTION_DAYS=14
BACKUP_MAX_AGE_HOURS=24
